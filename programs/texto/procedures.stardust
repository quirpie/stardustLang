app procedimientos-recursivos

actor IO:
  start:
    print('== Procedimientos recursivos ==')
    n = input('n = ')
    send(Math, n)
  on r:
    print('fib(n)  = ', r.fib)
    print('n!      = ', r.factorial)

actor Math:
  def fib(k):
    if k < 2:
      return k
    else:
      return fib(k - 1) + fib(k - 2)
  def fact(k):
    if k <= 1:
      return 1
    else:
      return k * fact(k - 1)
  on n:
    send(IO, {fib: fib(n), factorial: fact(n)})
